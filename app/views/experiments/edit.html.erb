<div class="max-w-3xl mx-auto">
  <div class="mb-8">
    <div class="flex items-center gap-4 mb-4">
      <%= link_to experiments_path, class: "inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-indigo-600 transition-colors group" do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform">
          <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
        </svg>
        Назад к экспериментам
      <% end %>
      <span class="text-slate-300">/</span>
      <%= link_to @experiment, class: "text-sm font-semibold text-slate-500 hover:text-indigo-600 transition-colors" do %>
        Результаты
      <% end %>
    </div>
    
    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Перенастройка симуляции</h1>
    <p class="text-slate-500 mt-1 text-lg">Корректировка параметров для <span class="text-indigo-600 font-bold">Эксперимента #<%= @experiment.id %></span></p>
  </div>

  <div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm">
    <%= render "form", experiment: @experiment %>
  </div>
</div>
