<%= form_with(model: experiment, class: "space-y-6") do |form| %>
  <% if experiment.errors.any? %>
    <div class="bg-rose-50 border border-rose-200 text-rose-800 p-4 rounded-2xl animate-in fade-in slide-in-from-top-2 duration-300">
      <div class="flex items-center gap-2 mb-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-rose-500">
          <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" />
        </svg>
        <h2 class="font-bold">
          Не удалось сохранить эксперимент (<%= pluralize(experiment.errors.count, "ошибка", "ошибки") %>):
        </h2>
      </div>
      <ul class="list-disc list-inside text-sm space-y-1 ml-7">
        <% experiment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <div class="group">
      <%= form.label :attacks_id, "Конфигурация атаки", class: "block text-sm font-bold text-slate-700 mb-1.5 transition-colors group-focus-within:text-indigo-600" %>
      <div class="relative">
        <%= form.collection_select :attacks_id, Attack.all, :id, ->(a) { "#{a.attack_type == 'linear' ? 'Линейная' : 'Экспоненциальная'} (A:#{a.a}, B:#{a.b})" }, { prompt: "Выберите конфигурацию атаки" }, 
              class: "block w-full rounded-xl border-slate-200 bg-slate-50 py-3 px-4 text-slate-900 focus:border-indigo-500 focus:ring-indigo-500 transition-all sm:text-sm appearance-none" %>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
            <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
          </svg>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="group">
        <%= form.label :p_single, "Вероятность однократного обнаружения p(t)", class: "block text-sm font-bold text-slate-700 mb-1.5 transition-colors group-focus-within:text-indigo-600" %>
        <%= form.text_field :p_single, placeholder: "например 0.8 или 0.43", class: "block w-full rounded-xl border-slate-200 bg-slate-50 py-3 px-4 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:ring-indigo-500 transition-all sm:text-sm" %>
      </div>

      <div class="group">
        <%= form.label :p_ai, "Вероятность появления атаки p(ai)", class: "block text-sm font-bold text-slate-700 mb-1.5 transition-colors group-focus-within:text-indigo-600" %>
        <%= form.text_field :p_ai, placeholder: "например 1.0 или 0.33", class: "block w-full rounded-xl border-slate-200 bg-slate-50 py-3 px-4 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:ring-indigo-500 transition-all sm:text-sm" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="group">
        <%= form.label :n, "Количество узлов (N)", class: "block text-sm font-bold text-slate-700 mb-1.5 transition-colors group-focus-within:text-indigo-600" %>
        <%= form.number_field :n, placeholder: "напр. 8", class: "block w-full rounded-xl border-slate-200 bg-slate-50 py-3 px-4 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:ring-indigo-500 transition-all sm:text-sm" %>
      </div>

      <div class="group">
        <%= form.label :k, "Количество тестировщиков (K)", class: "block text-sm font-bold text-slate-700 mb-1.5 transition-colors group-focus-within:text-indigo-600" %>
        <%= form.number_field :k, placeholder: "напр. 5", class: "block w-full rounded-xl border-slate-200 bg-slate-50 py-3 px-4 text-slate-900 placeholder:text-slate-400 focus:border-indigo-500 focus:ring-indigo-500 transition-all sm:text-sm" %>
      </div>
    </div>
  </div>

  <div class="pt-4 flex items-center gap-3">
    <%= form.submit "Запустить симуляцию", class: "flex-grow bg-indigo-600 text-white px-6 py-3 rounded-xl font-bold hover:bg-indigo-700 transition-all shadow-md hover:shadow-lg active:scale-[0.98] cursor-pointer" %>
    <%= link_to "Отмена", experiments_path, class: "px-6 py-3 text-slate-600 font-semibold hover:text-slate-900 transition-colors" %>
  </div>
<% end %>
